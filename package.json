{
  "name": "fluent-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop automation manager for ANSYS Fluent",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/check.ps1",
    "backend:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/backend-dev.ps1",
    "setup:electron": "pnpm exec electron --version"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "antd": "5.29.3",
    "i18next": "26.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "react-router-dom": "7.18.4",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
